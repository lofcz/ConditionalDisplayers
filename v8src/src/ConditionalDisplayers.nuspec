<?xml version="1.0"?>
<package>
  <metadata>
    <id>Our.Umbraco.ConditionalDisplayers</id>
    <version>2.3.10</version>
    <title>Our.Umbraco.ConditionalDisplayers</title>
    <authors>Matěj "lofcz" Štágl</authors>
    <owners>Mario Lopez</owners>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/KOBENDigital/ConditionalDisplayers</projectUrl>
    <icon>images\koben_logo.png</icon>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <summary>Umbraco property editors that allow the conditional display of other properties.</summary>
    <description>Umbraco property editors that allow the conditional display of other properties.</description>
    <releaseNotes>Now with more unicorns.</releaseNotes>
    <copyright>Copyright 2024</copyright>
    <tags>umbraco property editor</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.7.2">
        <dependency id="UmbracoCms.Core" version="[8.0,]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="App_Plugins\**\*.*" target="content\App_Plugins\" />
    <file src="images\koben_logo.png" target="images\" />
    <file src="bin\Release\Our.Umbraco.ConditionalDisplayers.*" target="lib\net472">
    </file>
  </files>
</package>